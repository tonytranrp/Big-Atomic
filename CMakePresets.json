{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "MSVC Debug (x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BA_ENABLE_COMPILE_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "MSVC Release (x64)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BA_ENABLE_COMPILE_TESTS": "ON"
      }
    },
    {
      "name": "wsl2-gcc-tsan",
      "displayName": "WSL2 GCC TSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wsl2-gcc-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -O1 -g",
        "BA_ENABLE_COMPILE_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build Debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build Release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "wsl2-tsan",
      "displayName": "Build WSL2 TSan",
      "configurePreset": "wsl2-gcc-tsan"
    }
  ],
  "testPresets": [
    {
      "name": "debug-tests",
      "displayName": "Run Debug Tests",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {
        "verbosity": "extra"
      }
    },
    {
      "name": "release-tests",
      "displayName": "Run Release Tests",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": {
        "verbosity": "extra"
      }
    },
    {
      "name": "wsl2-tsan-tests",
      "displayName": "Run WSL2 TSan Tests (No Benchmarks)",
      "configurePreset": "wsl2-gcc-tsan",
      "output": {
        "verbosity": "extra"
      },
      "filter": {
        "exclude": {
          "label": "Benchmark"
        }
      }
    }
  ]
}
